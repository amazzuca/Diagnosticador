# Modelo: "proveedor:modelo". Ej: openai:gpt-4o-mini | anthropic:claude-haiku-4-5
MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

AGENCY_NAME=Tu Agencia
# Logo bicolor del encabezado; "|" marca dónde empieza el color de acento. Ej: Pro|Pulse
BRAND_LOGO=
# (Opcional) Nombre del bot dentro del prompt. Por defecto: "Asistente de Relevamiento"
BOT_NAME=

# Mensajes del usuario por conversación (al llegar, el bot cierra el relevamiento) y límite por IP
MAX_TURNS=60
RATE_LIMIT_PER_HOUR=120

# Webhook de n8n y su token (header X-Auth-Token)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

# Postgres (Supabase, Session pooler) para persistir conversaciones, relevamientos y aprendizajes
DATABASE_URL=

# Dominios autorizados si embebés el chat en tu web (separados por coma). Vacío = todos.
ALLOWED_ORIGINS=
