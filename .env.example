# Modelo: "proveedor:modelo". Ej: openai:gpt-4o-mini | anthropic:claude-haiku-4-5
MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

AGENCY_NAME=Tu Agencia
MAX_TURNS=20
RATE_LIMIT_PER_HOUR=60

# Webhook de n8n que recibe el informe interno (opcional)
N8N_WEBHOOK_URL=

# Postgres para persistir conversaciones entre reinicios (opcional; ej. Neon o Supabase, con ?sslmode=require)
DATABASE_URL=

# Dominios autorizados si embebés el chat en tu web (separados por coma). Vacío = todos.
ALLOWED_ORIGINS=
